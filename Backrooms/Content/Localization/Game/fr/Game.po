#: Source/Backrooms/Private/BREntity.cpp(46)
msgctxt "BR,Entity.Hound.Description"
msgid "Des humanoïdes pâles et décharnés qui se déplacent à quatre pattes, le visage caché sous de longs cheveux noirs. Ils chassent en sentant la peur."
msgstr "Des humanoïdes pâles et décharnés qui se déplacent à quatre pattes, le visage caché sous de longs cheveux noirs. Ils chassent en sentant la peur."

