#: Source/Backrooms/Private/BRLevels.cpp(949)
#, fuzzy
msgctxt "BR,Note.Common.1"
msgid "RÈGLE N°1 : ne cours pas si tu n'y es pas obligé. Le bruit attire les choses."
msgstr "REGOLA N. 1: non correre se non sei costretto. Il rumore attira le cose."

#. Key:	Note.Common.2
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(950)
#: Source/Backrooms/Private/BRLevels.cpp(950)
#, fuzzy
msgctxt "BR,Note.Common.2"
