#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(592)
#: Source/Backrooms/Private/BRLevels.cpp(592)
#, fuzzy
msgctxt "BR,Level.11.Nickname"
msgid "La ville sans fin"
msgstr "La città infinita"

#. Key:	Level.11.Description
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(593)
#: Source/Backrooms/Private/BRLevels.cpp(593)
#, fuzzy
#| msgid "Une métropole infinie de gratte-ciel et d'avenues désertes, baignée de soleil. Des Facelings y vivent paisiblement. Ses immeubles mènent un peu partout."
msgctxt "BR,Level.11.Description"
msgid "Une métropole infinie de gratte-ciel et d'avenues désertes, baignée de soleil. Des Facelings y vivent paisiblement. Quelque part, une station attend ses derniers voyageurs."
msgstr "Una metropoli infinita di grattacieli e viali deserti, inondata di sole. I Faceling vi vivono in pace. Da qualche parte, una stazione aspetta i suoi ultimi viaggiatori."

#. Key:	Level.11.ClassText
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(595)
#: Source/Backrooms/Private/BRLevels.cpp(595)
#, fuzzy
msgctxt "BR,Level.11.ClassText"
msgid "Classe 1 : Sûr - Stable - Habité"
msgstr "Classe 1: Sicuro - Stabile - Abitato"

#. Key:	Note.L11.1
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(625)
#: Source/Backrooms/Private/BRLevels.cpp(625)
#, fuzzy
#| msgid "Les portes des immeubles mènent n'importe où. Vraiment n'importe où."
msgctxt "BR,Note.L11.1"
msgid "Les portes des immeubles sont murées. La seule route qui reste passe sous la ville, par la station. - L."
msgstr "Le porte dei palazzi sono murate. L'unica strada rimasta passa sotto la città, dalla stazione. - L."

#. Key:	Note.L11.2
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(626)
#: Source/Backrooms/Private/BRLevels.cpp(626)
#, fuzzy
msgctxt "BR,Note.L11.2"
msgid "Les Facelings d'ici sont gentils. Ils ne parlent pas, mais ils ne font pas de mal."
msgstr "I Facelings di qui sono gentili. Non parlano, ma non fanno del male."

#. Key:	Level.37.Title
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(636)
#: Source/Backrooms/Private/BRLevels.cpp(636)
#, fuzzy
msgctxt "BR,Level.37.Title"
msgid "Sublimity"
msgstr "Sublimity"

#. Key:	Level.37.Nickname
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(637)
#: Source/Backrooms/Private/BRLevels.cpp(637)
#, fuzzy
msgctxt "BR,Level.37.Nickname"
msgid "Les Poolrooms"
msgstr "Le Poolrooms"

#. Key:	Level.37.Description
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(638)
#: Source/Backrooms/Private/BRLevels.cpp(638)
#, fuzzy
msgctxt "BR,Level.37.Description"
msgid "Un dédale de couloirs carrelés bordés de canaux, d'arches et de salles inondées d'une eau tiède et claire. La lumière est douce, l'écho infini. Un calme presque réconfortant... presque."
msgstr "Un dedalo di corridoi piastrellati costeggiati da canali, archi e sale allagate di acqua tiepida e limpida. La luce è morbida, l'eco infinita. Una calma quasi confortante... quasi."

#. Key:	Level.37.ClassText
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(640)
#: Source/Backrooms/Private/BRLevels.cpp(640)
#, fuzzy
msgctxt "BR,Level.37.ClassText"
msgid "Classe 1 : Sûr - Stable - Aucune entité"
msgstr "Classe 1: Sicuro - Stabile - Nessuna entità"

#. Key:	Note.L37.1
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(687)
#: Source/Backrooms/Private/BRLevels.cpp(687)
#, fuzzy
msgctxt "BR,Note.L37.1"
msgid "L'eau est tiède. Elle n'a pas de fond, a certains endroits. N'y plonge pas."
msgstr "L'acqua è tiepida. In certi punti non ha fondo. Non tuffarti."

#. Key:	Note.L37.2
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(688)
#: Source/Backrooms/Private/BRLevels.cpp(688)
#, fuzzy
msgctxt "BR,Note.L37.2"
msgid "C'est beau ici. Trop beau. Je crois que je n'ai plus envie de partir. C'est ça, le piège."
msgstr "È bello qui. Troppo bello. Credo di non voler più andare via. È questa la trappola."

#. Key:	Note.L37.3
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(689)
#: Source/Backrooms/Private/BRLevels.cpp(689)
#, fuzzy
msgctxt "BR,Note.L37.3"
msgid "Nous sommes restés trop longtemps au bord de l'eau. M. voulait attendre ici. Nous sommes repartis sans elle, par l'échelle. Je reviendrai. - L."
msgstr "Siamo rimasti troppo a lungo vicino all'acqua. M. voleva aspettare qui. Siamo ripartiti senza di lei, su per la scala. Tornerò. - L."

