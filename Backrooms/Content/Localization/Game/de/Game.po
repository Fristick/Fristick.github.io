#: Source/Backrooms/Private/BREntity.cpp(74)
#, fuzzy
msgctxt "BR,Entity.Moth.Description"
msgid "Des papillons de nuit géants dont la piqûre est toxique. Ils sont irrésistiblement attirés par la lumière."
msgstr "Riesige Nachtfalter mit giftigem Stich. Licht zieht sie unwiderstehlich an."

#. Key:	Entity.Moth.Advice
#. SourceLocation:	Source/Backrooms/Private/BREntity.cpp(75)
#: Source/Backrooms/Private/BREntity.cpp(75)
#, fuzzy
msgctxt "BR,Entity.Moth.Advice"
