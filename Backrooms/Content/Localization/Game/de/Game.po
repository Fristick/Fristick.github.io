#: Source/Backrooms/Private/BREntity.cpp(47)
#, fuzzy
msgctxt "BR,Entity.Hound.Advice"
msgid "Ne fuyez jamais en courant devant un Hound. Faites-lui face, regardez-le et reculez calmement."
msgstr "Lauf niemals vor einem Hound weg. Stell dich ihm, sieh ihn an und weiche ruhig zurück."

