#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(831)
#: Source/Backrooms/Private/BRLevels.cpp(831)
#, fuzzy
msgctxt "BR,Content.ChannelAll"
msgid "version de développement"
msgstr "wersja deweloperska"

#. Key:	Content.Lot1
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(854)
#: Source/Backrooms/Private/BRLevels.cpp(854)
#, fuzzy
msgctxt "BR,Content.Lot1"
msgid "Le Seuil"
msgstr "Próg"

#. Key:	Content.Lot2
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(855)
#: Source/Backrooms/Private/BRLevels.cpp(855)
#, fuzzy
msgctxt "BR,Content.Lot2"
msgid "La Station et les Bureaux"
msgstr "Stacja i Biura"

#. Key:	Content.Lot3
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(856)
#: Source/Backrooms/Private/BRLevels.cpp(856)
#, fuzzy
msgctxt "BR,Content.Lot3"
