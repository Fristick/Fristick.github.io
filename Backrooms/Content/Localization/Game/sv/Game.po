#. Key:	Note.L11.1
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(547)
#: Source/Backrooms/Private/BRLevels.cpp(547)
#, fuzzy
msgctxt "BR,Note.L11.1"
msgid "Les portes des immeubles mènent n'importe où. Vraiment n'importe où."
msgstr "Byggnadernas dörrar leder vart som helst. Verkligen vart som helst."

#. Key:	Note.L11.2
#. SourceLocation:	Source/Backrooms/Private/BRLevels.cpp(548)
#: Source/Backrooms/Private/BRLevels.cpp(548)
#, fuzzy
msgctxt "BR,Note.L11.2"
msgid "Les Facelings d'ici sont gentils. Ils ne parlent pas, mais ils ne font pas de mal."
msgstr "Facelings här är snälla. De pratar inte, men de gör ingen illa."

