#: Source/Backrooms/Private/BREntity.cpp(59)
#, fuzzy
msgctxt "BR,Entity.Faceling.Advice"
msgid "Restez poli et gardez vos distances. Dans les champs, certains se tapissent dans les blés et attrapent ceux qui passent trop près."
msgstr "Sé amable y mantén la distancia. En los campos, algunos se agazapan entre el trigo y atrapan a quien pasa demasiado cerca."

