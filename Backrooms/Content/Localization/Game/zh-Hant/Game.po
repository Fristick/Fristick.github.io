#, fuzzy
msgctxt "BR,Key.Action.Battery"
msgid "CHANGER LES PILES"
msgstr "更換電池"

#. Key:	Key.Action.ThirdPerson
#. SourceLocation:	Source/Backrooms/Private/BRKeys.cpp(37)
