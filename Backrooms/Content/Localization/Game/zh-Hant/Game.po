#, fuzzy
msgctxt "BR,Key.Action.ThirdPerson"
msgid "VUE À LA 3E PERSONNE"
msgstr "第三人稱視角"

#. Key:	Key.Action.Pause
#. SourceLocation:	Source/Backrooms/Private/BRKeys.cpp(38)
#: Source/Backrooms/Private/BRKeys.cpp(38)
#, fuzzy
msgctxt "BR,Key.Action.Pause"
msgid "PAUSE"
msgstr "暫停"

#. Key:	Key.Action.PushToTalk
#. SourceLocation:	Source/Backrooms/Private/BRKeys.cpp(39)
