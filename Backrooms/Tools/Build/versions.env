# v4.9 : versions attendues des outils de construction (lues par build_*.sh et build_windows.ps1).
# Le script compare la version du moteur installe a UE_VERSION et s'arrete en cas d'ecart (BR_ALLOW_OTHER_UE=1 pour
# passer outre en connaissance de cause). Les versions des chaines de compilation sont relevees dans le manifeste de
# chaque construction (Build/<Plateforme>/<Config>/build_manifest.txt) ; renseigner ici celles qui ont ete validees.
UE_VERSION=5.8.3
# Linux : chaine clang d'Epic correspondant a UE 5.8 (dossier de LINUX_MULTIARCH_ROOT pour une construction depuis
# Windows ; ou clang fourni avec le moteur sous Linux). A renseigner apres la premiere construction validee.
LINUX_TOOLCHAIN=
# macOS : version de Xcode validee avec UE 5.8 (xcodebuild -version). A renseigner apres la premiere construction validee.
XCODE_VERSION=
